{
  "name": "@hotbar/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hotbar-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --watch dist/index.js",
    "start": "node --experimental-sqlite dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @hotbar/shared build && tsc -p tsconfig.json",
    "test": "node --experimental-sqlite --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "@hotbar/shared": "workspace:*",
    "fastify": "^5.6.1",
    "pidusage": "^4.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.2"
  }
}
