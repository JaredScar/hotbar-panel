{
  "name": "@hotbar/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Install and run game servers",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @hotbar/shared build && pnpm --filter @hotbar/agent build && tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "dist": "node ../../scripts/package-desktop.mjs win"
  },
  "build": {
    "appId": "com.hotbar.desktop",
    "productName": "Hotbar",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "assets/**/*", "preload.cjs", "package.json"],
    "extraResources": [
      { "from": "build/payload", "to": ".", "filter": ["agent/**/*", "ui/**/*"] }
    ],
    "win": { "target": "nsis", "icon": "assets/brand-mark.png", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Hotbar" },
    "mac": { "target": "dmg", "icon": "assets/brand-mark.png", "identity": null, "gatekeeperAssess": false, "category": "public.app-category.utilities" },
    "linux": { "target": ["deb", "AppImage"], "icon": "assets/brand-mark.png", "category": "Utility", "executableName": "hotbar", "synopsis": "Install and run game servers" },
    "deb": { "packageName": "hotbar" }
  },
  "dependencies": {
    "@hotbar/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2"
  }
}
